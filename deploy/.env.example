# 生产环境变量示例：复制为 /opt/campus-secondhand/.env 后按实际情况修改
# 注意：.env 含数据库密码，权限设置为 600，且不要提交到 Git 仓库

# ---------- 数据库 ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=campus_secondhand
DB_USER=campus
DB_PASSWORD=请改成真实密码

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ---------- RabbitMQ ----------
MQ_HOST=127.0.0.1
MQ_PORT=5672
MQ_USERNAME=guest
MQ_PASSWORD=guest
MQ_VHOST=/

# ---------- 文件与日志 ----------
UPLOAD_PATH=/data/campus-secondhand/upload/
LOG_PATH=/data/campus-secondhand/logs/

# ---------- 邮件（默认 mock，不真正外发；答辩演示建议保持 true） ----------
MAIL_MOCK=true
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=

# ---------- 业务参数 ----------
# 物品图片上传上限（字节）
FILE_MAX_SIZE=5242880
# 每页条数
APP_PAGE_SIZE=12
# 订单支付超时分钟数（兜底定时任务使用，MQ 延迟时间在 application.yml 的 mq.order.delay-ms）
APP_ORDER_TIMEOUT_MINUTES=30